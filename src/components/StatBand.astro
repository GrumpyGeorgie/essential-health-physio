---
---
<!-- Reviews + Stat band — one unified card, not two stacked blocks -->
<section class="section" style="padding-top:0;">
  <div class="gradient-band stat-band" data-reveal>
    <div class="stat-band__reviews">
      <h2>Our Google Reviews</h2>
      <div class="google-badge">
        <span style="font-weight:700;">Google</span>
        <span class="google-badge__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="google-badge__score">5.0</span>
        <span class="google-badge__count">| 325 reviews</span>
      </div>
    </div>
    <div class="stat-band__row">
      <div class="stat-band__item">
        <div class="stat-band__number">5,000+</div>
        <div class="stat-band__label">Patients Treated</div>
      </div>
      <div class="stat-band__item">
        <div class="stat-band__number">325</div>
        <div class="stat-band__label">5-Star Google Reviews</div>
      </div>
      <div class="stat-band__item">
        <div class="stat-band__number">3</div>
        <div class="stat-band__label">Brisbane Locations</div>
      </div>
    </div>
  </div>
</section>
