---
interface Props {
  phoneDisplay: string;
  phoneHref: string;
}
const { phoneDisplay, phoneHref } = Astro.props;
---
<section class="section call-cta" data-reveal>
  <h2>Not Sure What You Need?</h2>
  <p>Book a 15-minute complimentary phone call with our director therapist. He'll listen to what's going on, give you an honest read on whether we can help, and recommend a sensible next step — even if that's not booking with us.</p>
  <div class="btn-group">
    <a href="#book" class="btn btn--primary">Book Your Free 15-min Call</a>
    <a href={phoneHref} class="btn btn--outline-dark"><i class="fas fa-phone-alt"></i> Call {phoneDisplay}</a>
  </div>
</section>
