---
interface Props {
  phoneDisplay: string;
}
const { phoneDisplay } = Astro.props;
---
<section class="section booking-banner" data-reveal>
  <h2>Book Your First Visit</h2>
  <p>Prefer to book yourself in? Reserve your spot online in under a minute, or call the clinic and we'll find a time that works for you.</p>
  <div class="btn-group">
    <a href="#book" class="btn btn--primary">Book Your First Visit</a>
  </div>
  <div class="booking-banner__sub">Or Call {phoneDisplay}</div>
</section>
