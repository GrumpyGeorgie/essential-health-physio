---
---
<section class="lp-hero">
  <div class="lp-hero__bg">
    <img src="/images/lp-team-indoor.jpg" alt="" />
  </div>
  <div class="lp-hero__inner">
    <div class="lp-hero__content">
      <span class="eyebrow">Essential Health Physiotherapy Shailer Park</span>
      <h1>Regain confidence in living pain free to support your family life and hobbies</h1>
      <ul class="lp-hero__list">
        <li><i class="fas fa-check-circle"></i> Trusted by Local GPs</li>
        <li><i class="fas fa-check-circle"></i> Combined 70 years of clinical experience</li>
        <li><i class="fas fa-check-circle"></i> Hands-on approach</li>
        <li><i class="fas fa-check-circle"></i> Structured plan to recovery for lasting results</li>
        <li><i class="fas fa-check-circle"></i> Same-day appointments available</li>
      </ul>
      <p class="lp-hero__services-note">One stop destination for Physiotherapy, Exercise Physiology, Remedial Massage, Women's Health Physiotherapy, Dietetics, Lymphoedema Therapy &amp; Hydrotherapy.</p>
      <div class="lp-hero__trust">
        <span class="lp-hero__trust-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <strong>325 five-star reviews</strong>
        <a href="#">Read our Google reviews &rarr;</a>
      </div>
      <div class="btn-group" style="justify-content:flex-start;">
        <a href="#book" id="book" class="btn btn--primary">Book Your Appointment</a>
        <a href="tel:0731320898" class="btn btn--outline"><i class="fas fa-phone-alt"></i> Call (07) 3132 0898</a>
      </div>
    </div>

    <div class="lp-hero__side">
      <div class="lp-hero__video">
        <video controls preload="metadata" poster="/images/lp-team-indoor.jpg">
          <source src="https://assets.cdn.filesafe.space/5RSV9kpgbRBqjKQfOVjq/media/6a15abaf79d918ba609feb8b.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="lp-hero__survey">
        <iframe
          src="https://api.leadconnectorhq.com/widget/survey/DsLVKdIHjGKIq4QwkUF7"
          title="Essential Health Physio — patient survey"
          scrolling="yes"
          id="DsLVKdIHjGKIq4QwkUF7"
        ></iframe>
      </div>
    </div>
  </div>
</section>
