---
interface Props {
  phoneDisplay: string;
  phoneHref: string;
}
const { phoneDisplay, phoneHref } = Astro.props;

const locations = [
  {
    name: 'Birkdale',
    address: 'Shop 20a, 120 Birkdale Rd, Birkdale QLD 4159',
    // Real Birkdale clinic line — was previously (wrongly) showing the Shailer Park
    // number here. Fixed.
    phoneDisplay: '(07) 3822 8879',
    phoneHref: 'tel:0738228879',
    mapsQuery: 'Shop+20a%2C+120+Birkdale+Rd%2C+Birkdale+QLD+4159',
    embedQuery: 'Shop%2020a%2C%20120%20Birkdale%20Rd%2C%20Birkdale%20QLD%204159',
    hours: [['Mon–Fri', '7am–7pm'], ['Sat', '7am–12pm'], ['Sun', 'Closed']],
  },
  {
    name: 'Shailer Park',
    address: '2/2 Bulwarna St, Shailer Park QLD 4128',
    // Call-tracking number specific to this campaign — different from the number used
    // everywhere else on the site. Preserved as-is, not "corrected".
    phoneDisplay: '(07) 3102 1837',
    phoneHref: 'tel:0731021837',
    mapsQuery: '2%2F2+Bulwarna+St%2C+Shailer+Park+QLD+4128',
    embedQuery: '2%2F2%20Bulwarna%20St%2C%20Shailer%20Park%20QLD%204128',
    hours: [['Mon–Fri', '7am–7pm'], ['Sat', '7am–1pm'], ['Sun', 'Closed']],
  },
];
---

<footer class="lp-footer">
  <div class="lp-footer__brand">
    <img src="/images/logo-white.png" alt="Essential Health Physio" />
    <p>Helping you get back to the things you love</p>
  </div>
  <div class="lp-footer__grid">
    {locations.map((loc) => (
      <div class="lp-footer__location">
        <h3>{loc.name}</h3>
        <address>{loc.address}</address>
        <a class="phone" href={loc.phoneHref}>{loc.phoneDisplay}</a>
        <ul>
          {loc.hours.map(([day, time]) => <li><span>{day}</span><span>{time}</span></li>)}
        </ul>
        <a href={`https://www.google.com/maps/search/?api=1&query=${loc.mapsQuery}`} target="_blank" rel="noopener" class="card__link" style="margin-bottom:var(--space-s); display:inline-block;">Find Us</a>
        <iframe class="lp-footer__map" loading="lazy" title={`Map — ${loc.name}`} src={`https://maps.google.com/maps?q=${loc.embedQuery}&t=m&z=13&output=embed&iwloc=near`} style="width:100%; height:140px; border:0; border-radius:var(--radius-sm); display:block;"></iframe>
      </div>
    ))}
  </div>
  <div class="lp-footer__bottom">&copy; 2026 Essential Health Physio. All rights reserved.</div>
</footer>

<!-- Sticky mobile CTA bar — always-visible booking path, common LP conversion pattern -->
<div class="sticky-cta-bar">
  <a href="#book" class="btn btn--primary">Book Assessment</a>
  <a href={phoneHref} class="btn btn--outline-dark"><i class="fas fa-phone-alt"></i> Call Now</a>
</div>
