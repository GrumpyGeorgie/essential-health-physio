---
interface Props {
  phoneDisplay: string;
  phoneHref: string;
}
const { phoneDisplay, phoneHref } = Astro.props;
---
<section class="section final-cta" data-reveal>
  <h2>Ready to Live Better?</h2>
  <p>Book your first visit. Within the hour, you'll have a clear diagnosis, hands-on treatment, and a written plan for getting back to the things you love.</p>
  <div class="btn-group">
    <a href="#book" class="btn btn--primary">Book Your First Visit</a>
    <a href={phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt"></i> Call {phoneDisplay}</a>
  </div>
</section>
