---
interface Props {
  phoneDisplay: string;
  phoneHref: string;
}
const { phoneDisplay, phoneHref } = Astro.props;

const services = [
  { icon: 'fa-hands-holding-child', title: 'Physiotherapy', body: "Thorough hour-long assessments from master's-qualified physiotherapists. We diagnose the root cause, treat hands-on in the same session, and send you home with a written plan and clear timeframes. This is the core of what we do — and the reason most patients are referred to us by their GP.", link: 'https://essentialhealthphysio.com.au/physiotherapy/' },
  { icon: 'fa-dumbbell', title: 'Exercise Physiology', body: 'Once your pain is under control, our exercise physiologists build strength and conditioning programs to keep you moving well long-term. Especially valuable for chronic conditions, post-surgical recovery, and patients returning to sport.', link: 'https://essentialhealthphysio.com.au/exercise-physiology/' },
  { icon: 'fa-spa', title: 'Remedial Massage', body: "Hands-on muscle therapy coordinated with your physio treatment — not a separate appointment you have to organise elsewhere. Helps with chronic tension, sports recovery, and post-injury muscle tightness.", link: 'https://essentialhealthphysio.com.au/massage-therapy/' },
  { icon: 'fa-person-pregnant', title: "Women's Health Physiotherapy", body: 'Specialist physiotherapy for pelvic floor dysfunction, pregnancy and post-natal recovery, bladder issues, and pelvic pain — in a private, supportive setting with experienced women\'s health physios.', link: 'https://essentialhealthphysio.com.au/womens-health/' },
  { icon: 'fa-apple-whole', title: 'Nutrition & Dietetics', body: 'For patients where nutrition plays a role — anti-inflammatory eating for chronic pain, weight management for joint loading, recovery fuelling for surgical rehab — our dietitians work as part of your care team.', link: 'https://essentialhealthphysio.com.au/nutrition-and-dietetics/' },
  { icon: 'fa-water-ladder', title: 'Hydrotherapy', body: 'Pool-based exercise for patients who find land-based movement too painful — chronic pain, severe arthritis, post-surgical, or significant deconditioning. A gentler way to rebuild strength and mobility.', link: 'https://essentialhealthphysio.com.au/hydrotherapy/' },
];
---

<section class="section services-section" data-reveal>
  <div class="services-section__intro">
    <span class="eyebrow">Complete coordinated care</span>
    <h2>One Clinic. Everything You <span class="accent-word">Need</span>.</h2>
    <p>One stop destination for Physiotherapy, Exercise Physiology, Remedial Massage, Women's Health Physiotherapy, Dietetics, Lymphoedema Therapy &amp; Hydrotherapy.</p>
  </div>
  <div class="services-grid" data-reveal-group>
    {services.map((s) => (
      <div class="service-card">
        <div class="service-card__icon"><i class={`fas ${s.icon}`}></i></div>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
        <a href={s.link} class="card__link">Learn more</a>
      </div>
    ))}
  </div>
  <div class="text-center">
    <div class="btn-group">
      <a href="#book" class="btn btn--primary">Book Any Service</a>
      <a href={phoneHref} class="btn btn--outline-dark"><i class="fas fa-phone-alt"></i> Call {phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 8%, rgba(192, 228, 120, 0.2), transparent 22rem),
      linear-gradient(180deg, #f8fbff 0%, #eef9f7 100%);
  }

  .services-section::before {
    content: '';
    position: absolute;
    width: 220px;
    height: 220px;
    left: -110px;
    bottom: 10%;
    border: 32px solid rgba(84, 192, 228, 0.1);
    border-radius: 50%;
    pointer-events: none;
  }

  .services-section > * {
    position: relative;
    z-index: 1;
  }

  .services-section__intro {
    max-width: 760px;
    margin: 0 auto var(--space-xl);
    text-align: center;
  }

  .services-section__intro .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--accent-teal);
  }

  .services-section__intro h2 {
    margin-bottom: var(--space-s);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .services-section__intro p {
    max-width: 68ch;
    margin: 0 auto;
    color: #536474;
    font-size: var(--text-large);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .services-section :global(.service-card) {
    border: 1px solid rgba(0, 91, 176, 0.08);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 10px 30px rgba(0, 50, 100, 0.06);
  }
</style>
