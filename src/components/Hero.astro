---
<!-- Hero — no scroll-reveal here: it's above the fold on load, so fading it in would
     just be a flash-of-invisible-content risk if JS is slow to init. Reveal starts below. -->
<section class="hero" id="main">
  <div class="hero__inner">
    <div class="hero__content">
      <span class="eyebrow" style="color:var(--color-foreground); text-transform:none; font-size:var(--text-small); font-weight:600;">Physiotherapists Shailer Park, Birkdale &amp; Bracken Ridge</span>
      <h1>Pain Reduction and Improved Movement Through Effective Physiotherapy</h1>
      <p class="hero__subtext">Reclaim Your Health and Freedom from Pain with Expert Physiotherapy Care.</p>
      <div class="btn-group">
        <a href="#book" id="book" class="btn btn--primary">Book Now</a>
        <a href="tel:0731320898" class="btn btn--outline">Call Now</a>
      </div>
    </div>
    <div class="hero__image">
      <div class="hero__image-frame">
        <img src="/images/hero-physio-shailer-park.png" alt="Essential Health Physio physiotherapist treating a patient" />
        <div class="hero__trust-badge">
          <span class="hero__trust-badge__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <div>
            <div class="hero__trust-badge__score">5.0</div>
          </div>
          <div class="hero__trust-badge__label">325 Google<br />reviews</div>
        </div>
      </div>
    </div>
  </div>
</section>
