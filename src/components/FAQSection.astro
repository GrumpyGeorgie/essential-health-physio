---
interface QA { q: string; a: string }

interface Props {
  heading: string;
  intro?: string;
  items: QA[];
  fundingBadges?: boolean;
  centeredHeading?: boolean;
}

const { heading, intro, items, fundingBadges = false, centeredHeading = false } = Astro.props;
---

<section class="section faq-band" data-reveal>
  <div class:list={['faq-section', { 'faq-section--centered': centeredHeading }]}>
    <div class="faq-section__heading">
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="faq__list">
      {items.map((item) => (
        <details>
          <summary>{item.q} <span class="faq__icon"><i class="fas fa-chevron-down"></i></span></summary>
          <div class="faq__panel"><p set:html={item.a} /></div>
        </details>
      ))}
    </div>
  </div>
  {fundingBadges && (
    <div class="funding-badges">
      <img src="/images/ndis.png" alt="Registered NDIS Provider" />
      <img src="/images/workcover.png" alt="WorkCover Queensland" />
      <img src="/images/wha.png" alt="WHA" />
    </div>
  )}
</section>

<style>
  .faq-section--centered {
    grid-template-columns: minmax(0, 1fr);
    max-width: 980px;
  }

  .faq-section--centered .faq-section__heading {
    text-align: center;
  }

  .faq-section--centered .faq-section__heading h2 {
    margin-bottom: var(--space-l);
  }
</style>
