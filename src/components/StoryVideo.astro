<section class="section story-video" style="padding-top:0;" data-reveal>
  <h2>What is Our Story?</h2>
  <button type="button" class="story-video__frame" id="storyVideoFrame" data-video-id="7wTtADeM7KM" aria-label="Play video: What is Our Story?">
    <img src="/images/story-video-thumb.jpg" alt="" />
    <span class="story-video__play"><span>&#9654;</span></span>
  </button>
  <a href="#book" class="btn btn--primary">Book Now</a>
</section>

<script>
  // Story video — swap the thumbnail for a real YouTube embed on click, autoplaying.
  const videoFrame = document.getElementById('storyVideoFrame');
  videoFrame?.addEventListener('click', () => {
    const videoId = videoFrame.getAttribute('data-video-id');
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
    iframe.title = 'Essential Health Physiotherapy — What is Our Story?';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    videoFrame.replaceWith(iframe);
    iframe.className = 'story-video__frame';
    iframe.style.aspectRatio = '16/9';
    iframe.style.maxWidth = '600px';
    iframe.style.width = '100%';
    iframe.style.margin = '0 auto';
    iframe.style.display = 'block';
    iframe.style.borderRadius = 'var(--radius-md)';
    iframe.style.boxShadow = 'var(--shadow-md)';
  });
</script>
